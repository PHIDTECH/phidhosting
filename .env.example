# ============================================================
# PHIDHOSTING — Environment Variables
# ============================================================
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PHIDHOSTING"
NODE_ENV=development

# --- Database ---
# SQLite (development):
DATABASE_URL="file:./dev.db"
# MySQL (production):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/phidhosting"

# --- Authentication (NextAuth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET_32_CHARS"
AUTH_URL=http://localhost:3000

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@phidhosting.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="PHIDHOSTING <noreply@phidhosting.com>"

# --- Spaceship API (Domain Registrar) ---
# Docs: https://docs.spaceship.dev/
SPACESHIP_API_KEY=REPLACE_WITH_SPACESHIP_API_KEY
SPACESHIP_API_SECRET=REPLACE_WITH_SPACESHIP_API_SECRET
SPACESHIP_API_URL=https://api.spaceship.dev
SPACESHIP_SANDBOX=true

# --- WHM/cPanel API (Web Hosting Server) ---
WHM_HOST=https://your-server-ip:2087
WHM_USERNAME=root
WHM_API_TOKEN=REPLACE_WITH_WHM_API_TOKEN
WHM_SANDBOX=true

# --- Mailcow API (Email Hosting Server) ---
MAILCOW_HOST=https://mail.phidhosting.com
MAILCOW_API_KEY=REPLACE_WITH_MAILCOW_API_KEY
MAILCOW_SANDBOX=true

# --- Payment Gateways ---
# M-Pesa / Mobile Money (configure per gateway)
MPESA_API_KEY=REPLACE_WITH_MPESA_API_KEY
MPESA_API_SECRET=REPLACE_WITH_MPESA_API_SECRET
MPESA_SANDBOX=true

# --- Selcom Payment Gateway ---
# Docs: https://docs.selcom.net/
# Get credentials from https://portal.selcom.net/
SELCOM_API_KEY=REPLACE_WITH_SELCOM_API_KEY
SELCOM_API_SECRET=REPLACE_WITH_SELCOM_API_SECRET
SELCOM_VENDOR_ID=REPLACE_WITH_SELCOM_VENDOR_ID
SELCOM_SANDBOX=true

# --- Beem Africa SMS ---
# Docs: https://apisms.beem.africa/
# Get credentials from https://beem.africa/
BEEM_API_KEY=REPLACE_WITH_BEEM_API_KEY
BEEM_SECRET_KEY=REPLACE_WITH_BEEM_SECRET_KEY
BEEM_SENDER_NAME=PHIDHOST

# --- Company Details ---
NEXT_PUBLIC_COMPANY_NAME="PHIDHOSTING"
NEXT_PUBLIC_COMPANY_EMAIL=info@phidhosting.com
NEXT_PUBLIC_COMPANY_PHONE="+255 744 741 874"
NEXT_PUBLIC_COMPANY_ADDRESS="Dar es Salaam, Tanzania"
NEXT_PUBLIC_COMPANY_WEBSITE=https://www.phidhosting.com
